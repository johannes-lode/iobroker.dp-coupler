{
  "common": {
    "name": "dp-coupler",
    "version": "0.2.0",
    "news": {
      "0.2.0": {
        "en": "Tolerant mappingsRaw (JSON string or native array) with self-heal; config default normalization via configVersion; one-shot seeding from mappings.seed.json",
        "de": "Toleranter mappingsRaw (JSON-String oder natives Array) mit Self-Heal; Konfig-Default-Normalisierung über configVersion; einmaliges Seeding aus mappings.seed.json"
      },
      "0.1.0": {
        "en": "Initial proof-of-concept release"
      }
    },
    "title": "Datapoint Relay",
    "titleLang": {
      "en": "Datapoint Coupler",
      "de": "Datenpunkt-Koppler"
    },
    "desc": {
      "en": "Relays state changes between arbitrary datapoints via a JSON mapping file.",
      "de": "Leitet Zustandsänderungen zwischen beliebigen Datenpunkten über eine JSON-Mapping-Datei weiter."
    },
    "authors": ["Johannes Lode, NAEXT GmbH"],
    "keywords": ["relay", "mapping", "sync"],
	"licenseInformation": {
	      "license": "AGPL-3.0-only",
	      "type": "free",
	      "link": "https://raw.githubusercontent.com/johannes-lode/iobroker.dp-coupler/main/LICENSE"
	    },
    "mode": "daemon",
    "adminUI": { "config": "json" },
    "type": "general",
    "icon": "admin/dp-coupler.png",
	"extIcon": "https://raw.githubusercontent.com/johannes-lode/iobroker.dp-coupler/main/admin/dp-coupler.png",
    "enabled": true,
    "readme": "https://github.com/johannes-lode/iobroker.dp-coupler/blob/main/README.md",
    "loglevel": "info",
    "supportCustoms": false,
    "connectionType": "local",
    "dataSource": "push"
  },
  "native": {
    "mappingsRaw": "[]",
    "forwardOnAckDefault": false,
    "forwardChangesOnlyDefault": true,
    "propagateAckDefault": false,
    "syncIntervalValue": 0,
    "syncUnit": "ms",
    "relayOnChange": false,
    "enabledDefault": true,
    "coerceTypesDefault": true,
    "coerceStringsDefault": false,
    "configVersion": 0
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Adapter connected and mapping loaded",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
