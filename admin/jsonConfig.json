{
    "i18n": false,
    "type": "tabs",
    "items": {
        "tab_mapping": {
            "type": "panel",
            "label": "Mapping",
            "items": {
                "mappingsRaw": {
                    "type": "jsonEditor",
                    "label": "Mappings (JSON view)",
                    "readOnly": true,
                    "help": "Canonical storage form, read-only. The table below is the editor; its changes are written back here. Open to inspect or copy the JSON.",
                    "onChange": {
                        "alsoDependsOn": ["mappingsTable"],
                        "calculateFunc": "return data.mappingsTable === undefined ? data.mappingsRaw : JSON.stringify(data.mappingsTable, null, 2);",
                        "ignoreOwnChanges": true
                    }
                },
                "info_invalid_json": {
                    "type": "infoBox",
                    "boxType": "error",
                    "closeable": false,
                    "newLine": true,
                    "title": "Stored mapping is not a valid JSON array",
                    "text": "The table stays empty as long as the stored value cannot be parsed. Repair it via the command line. Caution: entering a row in the table replaces the stored value and discards the unparsable content.",
                    "hidden": "try { return Array.isArray(JSON.parse(data.mappingsRaw || '[]')); } catch (e) { return false; }"
                },
                "mappingsTable": {
                    "type": "table",
                    "label": "Couplings",
                    "newLine": true,
                    "uniqueColumns": ["source"],
                    "showFirstAddOnTop": true,
                    "export": true,
                    "compact": true,
                    "defaultFunc": "try { const v = JSON.parse(data.mappingsRaw || '[]'); return Array.isArray(v) ? v : undefined; } catch (e) { return undefined; }",
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "source",
                            "title": "Source",
                            "width": "22%",
                            "validator": "const v = (data.source || '').trim(); return v !== '' && !/\\s/.test(v) && !v.startsWith('.') && !v.endsWith('.') && !v.includes('..');",
                            "validatorErrorText": "Required: a state ID without blanks, without a leading/trailing dot and without '..'"
                        },
                        {
                            "type": "select",
                            "attr": "bidirectional",
                            "title": "↔",
                            "width": "5%",
                            "options": [
                                {"label": "→", "value": false},
                                {"label": "↔", "value": true}
                            ]
                        },
                        {
                            "type": "objectId",
                            "attr": "target",
                            "title": "Target",
                            "width": "22%",
                            "validator": "const v = (data.target || '').trim(); return v !== '' && !/\\s/.test(v) && !v.startsWith('.') && !v.endsWith('.') && !v.includes('..');",
                            "validatorErrorText": "Required: a state ID without blanks, without a leading/trailing dot and without '..'"
                        },
                        {
                            "type": "text",
                            "attr": "_comment",
                            "title": "Comment",
                            "width": "13%"
                        },
                        {
                            "type": "select",
                            "attr": "enabled",
                            "title": "Enabled",
                            "width": "9%",
                            "options": [
                                {"label": "(default)", "value": ""},
                                {"label": "yes", "value": true},
                                {"label": "no", "value": false}
                            ]
                        },
                        {
                            "type": "select",
                            "attr": "forwardOnAck",
                            "title": "On ACK",
                            "width": "9%",
                            "options": [
                                {"label": "(default)", "value": ""},
                                {"label": "yes", "value": true},
                                {"label": "no", "value": false}
                            ]
                        },
                        {
                            "type": "select",
                            "attr": "forwardChangesOnly",
                            "title": "Changes only",
                            "width": "10%",
                            "options": [
                                {"label": "(default)", "value": ""},
                                {"label": "yes", "value": true},
                                {"label": "no", "value": false}
                            ]
                        },
                        {
                            "type": "select",
                            "attr": "propagateAck",
                            "title": "Propagate ACK",
                            "width": "10%",
                            "options": [
                                {"label": "(default)", "value": ""},
                                {"label": "yes", "value": true},
                                {"label": "no", "value": false}
                            ]
                        }
                    ]
                }
            }
        },
        "tab_defaults": {
            "type": "panel",
            "label": "Adapter-Settings",
            "items": {
                "hdr_sync": {
                    "type": "staticText",
                    "text": "Periodic sync"
                },
                "syncIntervalValue": {
                    "type": "slider",
                    "label": "Interval",
                    "help": "0 = disabled. When set, all target datapoints are re-written at this interval with the last known source value (heartbeat/refresh). Only the forward direction (source → target) is synced; the reverse direction of bidirectional entries is not included in periodic updates.",
                    "min": 0,
                    "max": 200,
                    "step": 1,
                    "default": 0,
                    "sm": 9
                },
                "syncUnit": {
                    "type": "select",
                    "label": "Unit",
                    "options": [
                        {"label": "ms", "value": "ms"},
                        {"label": "s",  "value": "s"},
                        {"label": "min","value": "min"},
                        {"label": "h",  "value": "h"}
                    ],
                    "default": "ms",
                    "sm": 3
                },
                "relayOnChange": {
                    "type": "checkbox",
                    "label": "Also relay on change (in addition to periodic sync)",
                    "help": "When periodic sync is active (interval > 0), also relay immediately on source value change. Has no effect when interval is 0 — event-driven relay is always active then.",
                    "default": false,
                    "newLine": true,
                    "disabled": "(!data.syncIntervalValue)"
                },
                "divider_1": {
                    "type": "staticText",
                    "text": "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────",
                    "newLine": true
                },
                "hdr_defaults": {
                    "type": "staticText",
                    "text": "Relay defaults are applied to all mapping entries unless overridden per entry.",
                    "newLine": true
                },
                "forwardOnAckDefault": {
                    "type": "checkbox",
                    "label": "Forward on ACK (trigger on ack=true)",
                    "default": false,
                    "newLine": true
                },
                "forwardChangesOnlyDefault": {
                    "type": "checkbox",
                    "label": "Forward value changes only",
                    "default": true
                },
                "propagateAckDefault": {
                    "type": "checkbox",
                    "label": "Propagate ACK flag to target",
                    "default": false
                },
                "enabledDefault": {
                    "type": "checkbox",
                    "label": "Enable flag default",
                    "help": "Initial state of the per-channel enabled datapoint. Can be overridden per entry via the 'enabled' field of the mapping entry and toggled at runtime via the channels.<id>.enabled datapoints.",
                    "default": true
                },
                "divider_2": {
                    "type": "staticText",
                    "text": "────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────",
                    "newLine": true
                },
                "hdr_coerce": {
                    "type": "staticText",
                    "text": "Type coercion casts the source value to the target datapoint's type before writing. Only acts on type mismatch; matching types are passed through unchanged.",
                    "newLine": true
                },
                "coerceTypesDefault": {
                    "type": "checkbox",
                    "label": "Coerce types (bool ↔ number, C convention)",
                    "help": "Cast between boolean and number following C conventions: number 0 → false / non-0 → true, false → 0 / true → 1. Applied on both event relay and periodic sync.",
                    "default": true,
                    "newLine": true
                },
                "coerceStringsDefault": {
                    "type": "checkbox",
                    "label": "Also interpret strings",
                    "help": "Additionally interpret strings when coercing: \"\"/\"0\"/\"false\" → false, else → true; numeric strings → number. Unrecognized strings are passed through unchanged. Off by default (extra effort, opt-in).",
                    "default": false,
                    "disabled": "(!data.coerceTypesDefault)"
                }
            }
        }
    }
}
